# Reference only: the launcher DOES NOT source this file. Export values in your
# launch shell or inject them with your own credential manager. Never commit keys.
AI_GATEWAY_API_KEY=
# Optional override; unset/empty defaults to openai/gpt-6-sol-fast via AI Gateway.
JARVIS_MODEL=
JARVIS_DATA_DIR=
# Optional room workers: explicitly pull a reviewed platform digest first.
JARVIS_WORKER_IMAGE=
JARVIS_WORKER_PYTHON=
JARVIS_DOCKER_BINARY=
# Optional bridge-only voice. Enabling cloud voice also requires UI session consent.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional flags: empty/unset/0 = OFF; only the exact value 1 opts in.
JARVIS_ENABLE_DESKTOP=
JARVIS_ENABLE_TERMINAL=
JARVIS_ENABLE_APPLE_SERVICES=
JARVIS_ALLOW_HOME_ASSISTANT_HTTP=
# Web research is OFF without this key. Unset it and restart to disable.
# https://docs.tavily.com/documentation/quickstart
TAVILY_API_KEY=
# Home Assistant is OFF without both values. Unset both to disable.
# https://www.home-assistant.io/docs/authentication/
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# JARVIS_LOCAL_TOKEN is generated ephemerally by the launcher; never set/save it.
# JARVIS_NATIVE_HELPER is set to the absolute bundled executable by the launcher.
# Wake listening defaults OFF in the UI on every launch (not an environment flag).
